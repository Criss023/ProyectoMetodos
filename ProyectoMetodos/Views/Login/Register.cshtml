@{
    Layout = null;
    ViewBag.Title = "Registro";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f2f2f2;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .login-card {
            background-color: white;
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
            width: 100%;
            max-width: 400px;
        }

        .header-title {
            font-size: 2em;
            margin-bottom: 10px;
            text-align: center;
        }

        .header-subtitle {
            font-size: 1.3em;
            text-align: center;
            margin-bottom: 30px;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="header-title">Proyecto</div>
        <div class="header-subtitle">Métodos Numéricos</div>

        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success text-center">@TempData["Mensaje"]</div>
        }
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger text-center">@ViewBag.Error</div>
        }

        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger text-center" })

        @using (Html.BeginForm("Register", "Login", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label for="usuario" class="form-label">Usuario:</label>
                <input type="text"
                       id="usuario"
                       name="usuario"
                       class="form-control"
                       value="@(ViewBag.Usuario as string ?? "")" />
                @if (ViewData.ModelState["usuario"]?.Errors.Count > 0)
                {
                    <span class="text-danger">
                        @ViewData.ModelState["usuario"].Errors[0].ErrorMessage
                    </span>
                }
            </div>

            <div class="mb-3">
                <label for="contrasena" class="form-label">Contraseña:</label>
                <input type="password"
                       id="contrasena"
                       name="contrasena"
                       class="form-control" />
                @if (ViewData.ModelState["contrasena"]?.Errors.Count > 0)
                {
                    <span class="text-danger">
                        @ViewData.ModelState["contrasena"].Errors[0].ErrorMessage
                    </span>
                }
            </div>

            <div class="d-grid">
                <button type="submit" class="btn btn-success">Registrar</button>
            </div>
        }


        <div class="mt-3 text-center">
            @Html.ActionLink("Volver a Iniciar Sesión", "Index", "Login", null, new { @class = "btn btn-link" })
        </div>

        <hr class="my-4" />

        <div class="text-center" style="font-size: 0.9em;">
            <p>Facultad de Ingeniería en Sistemas</p>
            <p>Centro Universitario de Chiquimulilla, Santa Rosa</p>
            <p>Semestre 5-2025</p>
            <img src="~/Content/Images/Logo.png" alt="Logo del proyecto" style="height: 60px; margin-top: 10px;" />
        </div>
    </div>
</body>
</html>
